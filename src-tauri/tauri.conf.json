{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipLingo",
  "version": "0.2.1",
  "identifier": "app.lexi.cliptranslator",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClipLingo 设置",
        "width": 760,
        "height": 540,
        "minWidth": 680,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/ocr-models/*"
    ],
    "macOS": {
      "signingIdentity": "Local Development Code Signing",
      "minimumSystemVersion": "13.5"
    }
  }
}
